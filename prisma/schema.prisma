// Prisma schema - vedi https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TEACHER
  STUDENT
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  // A completamento: lo studente scrive la risposta invece di sceglierla. Sono 16
  // domande su 31 nelle prove del semestre filtro. Le risposte accettate stanno
  // ugualmente in AnswerOption, una riga per variante ammessa, tutte con
  // isCorrect = true: la prima e quella "giusta" da mostrare nella correzione.
  COMPLETAMENTO
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  // Percorso scelto dallo studente (vedi src/lib/tracks.ts).
  track        String   @default("PROFESSIONI_SANITARIE")
  createdAt    DateTime @default(now())

  testsCreated Test[]           @relation("TestCreator")
  assignments  TestAssignment[]
  attempts     Attempt[]
}

model Test {
  id               String   @id @default(cuid())
  title            String
  description      String?
  createdById      String
  createdBy        User     @relation("TestCreator", fields: [createdById], references: [id])
  isPublished      Boolean  @default(false)
  shuffleQuestions Boolean  @default(false)
  timeLimitMinutes Int?
  maxAttempts      Int?
  kind             String   @default("SIMULAZIONE")
  // Percorso a cui appartiene il test e la sua banca dati.
  track            String   @default("PROFESSIONI_SANITARIE")
  folder           String?
  isGenerated      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Domande scritte dall'insegnante dentro questo test (e le domande della banca
  // dati, che stanno nel test POOL del percorso).
  questions   Question[]
  // Domande prese in prestito dalla banca dati: le usano i test generati, che le
  // richiamano invece di copiarle. Un test usa l'una o l'altra forma, mai entrambe.
  pescate     TestQuestion[]
  assignments TestAssignment[]
  attempts    Attempt[]

  @@index([kind])
  @@index([track])
  @@index([createdById])
}

model Question {
  id      String       @id @default(cuid())
  testId  String
  test    Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  type    QuestionType
  subject String
  topic   String?
  text    String
  order   Int
  points  Int          @default(1)

  options       AnswerOption[]
  answerRecords AnswerRecord[]
  usiNeiTest    TestQuestion[]

  @@index([testId])
  @@index([subject])
  @@index([topic])
}

// Una domanda della banca dati richiamata da un test generato, alla sua posizione.
//
// Prima ogni test generato conservava una *copia* delle domande e delle opzioni:
// una simulazione da 60 domande scriveva ~360 righe e ~175 KB che restavano nel
// database per sempre. Qui il test tiene solo un riferimento e l'ordine, cioè una
// riga minuscola per domanda. Vedi src/lib/test-questions.ts.
model TestQuestion {
  id         String   @id @default(cuid())
  testId     String
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int

  @@unique([testId, questionId])
  @@index([testId])
  @@index([questionId])
}

model AnswerOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int

  answerRecords AnswerRecord[]
}

model TestAssignment {
  id         String   @id @default(cuid())
  testId     String
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([testId, studentId])
}

model Attempt {
  id          String        @id @default(cuid())
  testId      String
  test        Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId   String
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  score       Float?
  maxScore    Float?

  // Le prove del semestre filtro si svolgono una materia per volta, come all'esame:
  // qui si tiene quale sezione è aperta e da quando. Senza questi due campi il
  // cronometro della materia ripartirebbe a ogni ricaricamento della pagina e una
  // materia consegnata si potrebbe riaprire. Nei test di una materia sola restano
  // al valore di partenza e non cambiano niente. Vedi src/lib/test-sections.ts.
  sezione           Int       @default(0)
  sezioneIniziataIl DateTime?

  answers      AnswerRecord[]
  subjectStats AttemptSubjectStat[]

  @@index([studentId])
  @@index([testId])
  @@index([status])
}

// Risultato per materia di un singolo tentativo, calcolato una volta sola alla
// consegna. Le pagine di analisi leggono queste poche righe invece di riesaminare
// tutte le risposte: un tentativo da 60 domande produce ~5 righe invece di 60,
// e il piano Turso conta le righe esaminate da ogni query.
model AttemptSubjectStat {
  id        String  @id @default(cuid())
  attemptId String
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  subject   String
  correct   Int
  // Quante risposte sono state date, giuste o sbagliate. Senza questo numero una
  // risposta errata (che nel semestre filtro toglie 0,1) e una lasciata in bianco
  // (che non toglie niente) sono indistinguibili, e il voto della singola prova
  // non si può più ricalcolare dallo storico. Vedi src/lib/esame.ts.
  answered  Int     @default(0)
  total     Int

  @@unique([attemptId, subject])
  @@index([subject])
}

// Appunti di ripasso, uno per argomento di programma. Il testo è markdown scritto
// dall'insegnante (o preparato e poi revisionato da lui): resta modificabile dalla
// sua area senza toccare il codice, e diventa visibile agli studenti solo quando
// viene pubblicato.
model TopicNote {
  id          String   @id @default(cuid())
  topic       String   @unique
  track       String
  subject     String
  title       String
  body        String
  // Note di revisione per l'insegnante (punti da controllare, dati aggiunti da
  // fuori le fonti): non vengono mai mostrate agli studenti.
  reviewNotes String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([track])
  @@index([isPublished])
}

model AnswerRecord {
  id               String        @id @default(cuid())
  attemptId        String
  attempt          Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   AnswerOption? @relation(fields: [selectedOptionId], references: [id])
  // Il testo scritto dallo studente nelle domande a completamento. Si conserva
  // com’è stato digitato: serve a fargli vedere nella correzione cosa aveva messo.
  typedAnswer      String?
  isCorrect        Boolean?

  @@unique([attemptId, questionId])
}

// Chi arriva dalla pagina pubblica dell'open day e svolge la simulazione gratuita.
// Non è un User e non lo diventa: creare un account per ogni visitatore
// riempirebbe per sempre le statistiche dell'insegnante, lo storico e i conteggi
// di finti studenti, e non si tornerebbe più indietro. Qui invece sta tutto in una
// riga sola, che si esporta e si cancella senza toccare il resto.
model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Chiesti prima della simulazione: due campi, non di più. Ogni campo in più
  // prima del test è gente che non lo inizia.
  nome  String
  email String @unique

  // Chiesti dopo, in cambio della correzione commentata. Chi non li lascia resta
  // comunque un contatto valido: il motivo per cui si chiede l'email all'inizio.
  telefono String?
  scuola   String?
  anno     String?

  // Il percorso scelto col primo clic (vedi src/lib/tracks.ts). È la segmentazione
  // migliore che abbiamo e non costa niente a chi la dà.
  percorso String

  // Da quale inserzione è arrivato. Senza questi tre campi, a campagna finita non
  // si sa quale annuncio ha portato i contatti e quale ha solo speso.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  // Consenso a essere ricontattato a scopo commerciale. È separato dall'uso dei
  // dati per erogare la simulazione, e deve restare separato: sono due cose
  // diverse e il secondo non si può dare per scontato col primo.
  consensoMarketing Boolean   @default(false)
  consensoIl        DateTime?

  // Esito della simulazione. Le risposte stanno in un campo solo perché non si
  // interrogano mai per singola domanda: servono per rimostrare la correzione.
  //
  // iniziataIl si scrive quando la prova parte, completataIl solo alla consegna:
  // chi ha le due date diverse ha abbandonato a metà, ed è un contatto che
  // interessa quanto gli altri — anzi, è quello da richiamare per primo.
  simulazioneIniziataIl DateTime?
  completataIl          DateTime?
  punteggio             Float?
  risposte              Json?

  // Ha chiesto il posto per la diretta. I posti sono limitati davvero, quindi
  // questo numero è quello che si conta per chiudere le iscrizioni.
  postoDiretta   Boolean   @default(false)
  postoDirettaIl DateTime?

  @@index([createdAt])
  @@index([percorso])
}

// Una lezione registrata. Il video **non** sta qui: un'ora di lezione sono
// centinaia di megabyte, e servirla a cento studenti si paga a peso. Il filmato
// resta su YouTube o Vimeo, che hanno banda e lettore; da noi sta la scheda, e
// soprattutto il legame con l'argomento del programma — che è la cosa che una
// playlist non sa fare: dall'appunto sulla cellula si arriva alla lezione sulla
// cellula, e da un'esercitazione andata male alla lezione che la spiega.
model Lezione {
  id          String  @id @default(cuid())
  titolo      String
  descrizione String?

  // Percorso, materia e argomento: gli stessi valori usati da domande e appunti
  // (vedi src/lib/tracks.ts e src/lib/topics.ts). La materia e l'argomento sono
  // facoltativi, perché una lezione introduttiva non parla di un argomento solo.
  track   String
  subject String?
  topic   String?

  /// Quando si è tenuta, non quando è stata caricata.
  data         DateTime
  durataMinuti Int?

  // Una lezione è registrata **oppure** in diretta.
  //
  // Registrata: si tiene il fornitore e l'identificativo invece dell'indirizzo
  // intero, così la pagina costruisce il lettore da sé e non può finirci dentro
  // niente che non sia uno dei due fornitori previsti.
  fornitore String?
  videoId   String?

  // In diretta: l'indirizzo della riunione. Qui l'indirizzo intero serve per
  // forza — non è un filmato con un identificativo, è un invito — e infatti
  // questa non si incorpora: Teams rifiuta di farsi mettere dentro un iframe,
  // quindi in pagina diventa un pulsante che porta fuori. Chi legge deve essere
  // un fornitore riconosciuto: vedi `urlDirettaValido` in src/lib/lezioni.ts.
  urlDiretta String?

  // Come per gli appunti: una lezione la vedono gli studenti solo quando
  // l'insegnante l'ha riguardata e pubblicata.
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([track, isPublished])
  @@index([topic])
}

// Il test di valutazione iniziale, fatto il primo giorno di corso senza account.
//
// Non è un Attempt: un Attempt appartiene a uno User, e questi ragazzi un account
// non ce l'hanno ancora. Non è nemmeno un Lead: un Lead è un contatto arrivato da
// un annuncio, da richiamare; questo è uno studente già iscritto, di cui si
// misurano i prerequisiti. Due cose con due cicli di vita diversi, e tenerle
// nella stessa tabella vorrebbe dire sporcare le statistiche di entrambe.
//
// Nome e cognome e basta: all'inizio del corso l'elenco degli iscritti ce
// l'abbiamo già, e ogni campo in più prima di una prova è gente che non la
// comincia.
model ProvaIngresso {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  nome    String
  cognome String

  // completataIl resta vuoto per chi ha cominciato e non ha consegnato: è un
  // dato, non un difetto, e dice che la prova era troppo lunga o che se n'è
  // andato.
  completataIl DateTime?
  punti        Float?

  // Il riepilogo per materia e per unità del syllabus, calcolato alla consegna.
  // Ricalcolarlo a ogni visita vorrebbe dire rileggere tutte le risposte di
  // tutti per disegnare una tabella.
  esito Json?

  // Quello che ha risposto, per poter rivedere la prova con lui. Non si
  // interroga mai per singola domanda, quindi sta in un campo solo.
  risposte Json?

  @@index([createdAt])
}
